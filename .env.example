# Copy to .env and fill in values (never commit .env)

# Telegram Bot integration (Next.js server routes: /api/contact & /api/resume-download)
# Keep these strictly server-side (never prefix with NEXT_PUBLIC_)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Upstash Redis for persistent Resume Download Counter (auto-injected via Vercel Marketplace)
# Supports either UPSTASH_REDIS_REST_* or KV_REST_API_* naming
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Timezone used for Telegram notification timestamps & daily reset (default: Asia/Dhaka)
# NOTIFICATION_TIMEZONE=Asia/Dhaka

# Optional: Cloudflare Turnstile verification (client + server)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional: Image CDN overrides
# NEXT_PUBLIC_CDN_BASE_URL=
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
