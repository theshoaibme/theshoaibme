# Public values used during `npm run build` (safe in GitHub Actions secrets)

# reCAPTCHA v2 Checkbox SITE key (public)
VITE_RECAPTCHA_SITE_KEY=

# Cloudflare Worker URL after deploy, example:
# https://portfolio-contact-api.your-subdomain.workers.dev
VITE_CONTACT_API_URL=

# Optional EmailJS overrides for local fallback mode
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# NEVER put these in GitHub frontend secrets or .env for Vite:
# - reCAPTCHA SECRET key
# - TELEGRAM_BOT_TOKEN
# - TELEGRAM_CHAT_ID
#
# Put those in Cloudflare Worker secrets instead:
# cd workers/contact-api
# npm install
# npx wrangler secret put RECAPTCHA_SECRET
# npx wrangler secret put TELEGRAM_BOT_TOKEN
# npx wrangler secret put TELEGRAM_CHAT_ID
# npm run deploy
