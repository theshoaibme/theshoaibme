# Copy to .env and fill in values (never commit .env)

# Telegram Bot integration (Next.js server route /api/contact)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# For static builds (GitHub Pages / Vite), expose via NEXT_PUBLIC_ or VITE_ prefix:
# NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=
# NEXT_PUBLIC_TELEGRAM_CHAT_ID=

# Optional
# VITE_CDN_BASE_URL=
# VITE_CLOUDINARY_CLOUD_NAME=
