# Public values used during `pnpm build` (safe in GitHub Actions secrets)

# Cloudflare Turnstile SITE key (public)
VITE_TURNSTILE_SITE_KEY=

# Cloudflare Worker URL
VITE_CONTACT_API_URL=https://portfolio-contact-api.the-shoaib2.workers.dev

# Private keys go in Cloudflare Worker secrets, NOT here.
# Required Worker secrets:
# - TURNSTILE_SECRET_KEY
# - EMAILJS_PRIVATE_KEY
# - TELEGRAM_BOT_TOKEN
# - TELEGRAM_CHAT_ID

# GitHub Actions secrets (Repository or cloudflare-workers environment):
# - CLOUDFLARE_API_TOKEN   (Workers Scripts:Edit)
# - CLOUDFLARE_ACCOUNT_ID
# - VITE_TURNSTILE_SITE_KEY
# - VITE_CONTACT_API_URL
