# Copy to .env and fill in values (never commit .env)

# Telegram Bot integration (Next.js server routes: /api/contact & /api/resume-download)
# Keep these strictly server-side (never prefix with NEXT_PUBLIC_)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Cloudflare Turnstile server-side verification
# TURNSTILE_SECRET_KEY=

# Optional
# VITE_CDN_BASE_URL=
# VITE_CLOUDINARY_CLOUD_NAME=
