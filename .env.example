# Copy to .env and fill in values (never commit .env)

# Cloudflare Turnstile site key (contact form + resume download tracking)
VITE_TURNSTILE_SITE_KEY=

# Contact / resume tracking Worker URL (production)
VITE_CONTACT_API_URL=https://portfolio-contact-api.the-shoaib2.workers.dev

# AES-256 key for portfolio data.enc (must match build + runtime)
# Generate: openssl rand -base64 32
VITE_DATA_ENCRYPTION_KEY=

# Optional
# VITE_CDN_BASE_URL=https://images.theshoaib.me
# VITE_CLOUDINARY_CLOUD_NAME=
