# Copy to .env and fill in your values (never commit .env)

# ── Cloudflare Turnstile (required for contact form) ──────────────────────
# 1. Go to https://dash.cloudflare.com → Turnstile → Add widget
# 2. Widget mode: Managed (recommended)
# Both production URLs work for the site and contact form:
#   https://theshoaib.me
#   https://the-shoaib2.github.io
#
# Turnstile widget domains (Cloudflare Dashboard): theshoaib.me, www.theshoaib.me,
# the-shoaib2.github.io, localhost
# 4. Copy the SITE key here (NOT the test/dummy keys — they show "For testing only")
VITE_TURNSTILE_SITE_KEY=

# ── Contact API ─────────────────────────────────────────────────────────────
VITE_CONTACT_API_URL=https://portfolio-contact-api.the-shoaib2.workers.dev

# ── Image CDN (Cloudinary) ──────────────────────────────────────────────────
VITE_CLOUDINARY_CLOUD_NAME=ddp8owdtu
# Optional transforms (default: f_auto,q_auto)
# VITE_CLOUDINARY_TRANSFORMS=f_auto,q_auto,w_1200

# Upload script only (never expose in Vite / client):
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional override for R2/custom CDN instead of Cloudinary:
# VITE_CDN_BASE_URL=https://images.theshoaib.me

# ── Worker secrets (set via wrangler, NOT in .env) ────────────────────────
# npx wrangler secret put TURNSTILE_SECRET_KEY   ← Secret key from same Turnstile widget
# npx wrangler secret put EMAILJS_PRIVATE_KEY
# npx wrangler secret put TELEGRAM_BOT_TOKEN
# npx wrangler secret put TELEGRAM_CHAT_ID

# ── GitHub Actions secrets (for production deploy) ──────────────────────────
# CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID
# VITE_TURNSTILE_SITE_KEY, VITE_CONTACT_API_URL, VITE_CLOUDINARY_CLOUD_NAME
