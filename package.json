{
  "name": "theshoaibme.github.io",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "cdn:fetch-images": "node scripts/fetch-images.mjs",
    "cdn:sync": "node scripts/sync-images-to-r2.mjs",
    "cdn:deploy": "npm run deploy --prefix workers/image-cdn",
    "cdn:verify": "node scripts/verify-cdn.mjs",
    "cdn:upload": "node scripts/upload-images-cloudinary.mjs",
    "cdn:setup": "node scripts/setup-cdn.mjs && pnpm cdn:fetch-images && cd workers/image-cdn && npm ci && npx wrangler r2 bucket create portfolio-images || true && cd ../.. && pnpm cdn:sync && pnpm cdn:deploy",
    "test:unit": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@paper-design/shaders-react": "^0.0.82",
    "dompurify": "^3.4.17",
    "framer-motion": "^14.13.0",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}
