{
  "name": "the-shoaib2.github.io",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "vite",
    "encrypt:data": "node scripts/encrypt-portfolio-data.mjs",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "cdn:fetch-images": "node scripts/fetch-images.mjs",
    "cdn:sync": "node scripts/sync-images-to-r2.mjs",
    "cdn:deploy": "npm run deploy --prefix workers/image-cdn",
    "cdn:verify": "node scripts/verify-cdn.mjs",
    "cdn:upload": "node scripts/upload-images-cloudinary.mjs",
    "cdn:setup": "node scripts/setup-cdn.mjs && pnpm cdn:fetch-images && cd workers/image-cdn && npm ci && npx wrangler r2 bucket create portfolio-images || true && cd ../.. && pnpm cdn:sync && pnpm cdn:deploy",
    "test:unit": "node --test scripts/images.test.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.3",
    "dompurify": "^3.2.6",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.23",
    "motion": "^12.40.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^8.0.16"
  }
}
